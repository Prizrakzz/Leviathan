{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leviathan/silver-eda/feature-candidate/1",
  "type": "object",
  "required": [
    "candidate_id",
    "source_table",
    "classification",
    "feature_family",
    "mechanism",
    "source_columns",
    "transformation",
    "aggregation_window",
    "lag",
    "output_grain",
    "unit",
    "observation_time_rule",
    "knowledge_time_rule",
    "visibility_class",
    "applicable_commodities",
    "applicable_geographies",
    "missingness_policy",
    "normalization_policy",
    "clipping_policy",
    "expected_range",
    "semantic_scope",
    "feature_policy",
    "future_target_compatibility",
    "evidence",
    "counter_evidence",
    "computation_primitive",
    "readiness",
    "review_status"
  ],
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "source_table": {"type": "string", "pattern": "^silver_"},
    "classification": {"enum": ["existing", "extension", "new", "anti_feature"]},
    "feature_family": {"type": ["string", "null"]},
    "mechanism": {"type": "string", "minLength": 1},
    "source_columns": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "transformation": {"type": "object"},
    "aggregation_window": {"type": ["string", "null"]},
    "lag": {"type": ["integer", "string", "null"]},
    "output_grain": {"type": "string", "minLength": 1},
    "unit": {"type": ["string", "null"]},
    "observation_time_rule": {"type": "string", "minLength": 1},
    "knowledge_time_rule": {"type": "string", "minLength": 1},
    "visibility_class": {"type": "string", "minLength": 1},
    "applicable_commodities": {"type": "array", "items": {"type": "string"}},
    "applicable_geographies": {"type": "array", "items": {"type": "string"}},
    "missingness_policy": {"type": "string", "minLength": 1},
    "normalization_policy": {"type": "string", "minLength": 1},
    "clipping_policy": {"type": "string", "minLength": 1},
    "expected_range": {"type": ["string", "null"]},
    "semantic_scope": {"type": "string", "minLength": 1},
    "feature_policy": {"type": "string", "minLength": 1},
    "future_target_compatibility": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "counter_evidence": {"type": "array", "items": {"type": "string"}},
    "computation_primitive": {"type": "string", "minLength": 1},
    "readiness": {
      "enum": [
        "ready_for_prototype",
        "needs_contract_or_data_fix",
        "diagnostic_only",
        "blocked"
      ]
    },
    "review_status": {"enum": ["unreviewed", "accepted", "rejected"]}
  },
  "additionalProperties": false
}
