{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leviathan/silver-eda/reader-metadata/1",
  "$defs": {
    "columnBoundPlan": {
      "type": "object",
      "required": ["columns"],
      "properties": {
        "columns": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "kpi": {
      "allOf": [
        {"$ref": "#/$defs/columnBoundPlan"},
        {
          "type": "object",
          "required": ["kpi_id", "label", "kind"],
          "properties": {
            "kpi_id": {"type": "string", "minLength": 1},
            "label": {"type": "string", "minLength": 1},
            "kind": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "qualityRule": {
      "allOf": [
        {"$ref": "#/$defs/columnBoundPlan"},
        {
          "type": "object",
          "required": [
            "rule_id",
            "label",
            "kind",
            "severity",
            "unsupported_result",
            "detail"
          ],
          "properties": {
            "rule_id": {"type": "string", "minLength": 1},
            "label": {"type": "string", "minLength": 1},
            "kind": {"type": "string", "minLength": 1},
            "severity": {"enum": ["pass", "caveat", "blocker"]},
            "unsupported_result": {"const": "not_assessed"},
            "detail": {"type": "string"}
          }
        }
      ]
    },
    "chart": {
      "allOf": [
        {"$ref": "#/$defs/columnBoundPlan"},
        {
          "type": "object",
          "required": [
            "chart_id",
            "chart_type",
            "title",
            "purpose",
            "minimum_rows"
          ],
          "properties": {
            "chart_id": {"type": "string", "minLength": 1},
            "chart_type": {"type": "string", "minLength": 1},
            "title": {"type": "string", "minLength": 1},
            "purpose": {"type": "string", "minLength": 1},
            "minimum_rows": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "insight": {
      "allOf": [
        {"$ref": "#/$defs/columnBoundPlan"},
        {
          "type": "object",
          "required": ["insight_id", "kind", "purpose", "minimum_rows"],
          "properties": {
            "insight_id": {"type": "string", "minLength": 1},
            "kind": {"type": "string", "minLength": 1},
            "purpose": {"type": "string", "minLength": 1},
            "minimum_rows": {"type": "integer", "minimum": 1}
          }
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "table_name",
    "archetype",
    "row_meaning",
    "column_descriptions",
    "units",
    "why_it_matters",
    "primary_measures",
    "dashboard_kpis",
    "quality_rules",
    "chart_plan",
    "insight_rules",
    "preview_strata",
    "pit_notes",
    "anti_features",
    "known_hazards",
    "feature_quarantined"
  ],
  "properties": {
    "schema_version": {"const": "leviathan.silver-eda-reader/v1"},
    "table_name": {"type": "string", "pattern": "^silver_"},
    "archetype": {
      "enum": [
        "spatial_weather_vegetation",
        "continuous_market_macro_climate",
        "annual_geographic_production",
        "monthly_domain",
        "progressive_cumulative",
        "vintage_revision",
        "esr_paired",
        "small_derived_contract_incomplete",
        "generated_output_quarantine"
      ]
    },
    "row_meaning": {"type": "string", "minLength": 1},
    "column_descriptions": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "units": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "why_it_matters": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "primary_measures": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "dashboard_kpis": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/kpi"}
    },
    "quality_rules": {
      "type": "array",
      "minItems": 8,
      "items": {"$ref": "#/$defs/qualityRule"}
    },
    "chart_plan": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/chart"}
    },
    "insight_rules": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/insight"}
    },
    "preview_strata": {
      "type": "array",
      "maxItems": 4,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "pit_notes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "anti_features": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "known_hazards": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "feature_quarantined": {"type": "boolean"}
  },
  "additionalProperties": false
}
