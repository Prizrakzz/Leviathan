{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leviathan/silver-eda/reader-evidence/1",
  "type": "object",
  "required": [
    "schema_version",
    "table_name",
    "archetype",
    "row_meaning",
    "source_rows",
    "analysis_rows",
    "plotted_rows",
    "exactness",
    "source_shape",
    "display_policy",
    "preview",
    "df_info_text",
    "column_dictionary",
    "dashboard_kpis",
    "ordinary_statistics",
    "quality_scorecard",
    "reader_insights",
    "notable_rows",
    "chart_plan",
    "pit_summary",
    "anti_feature_summary",
    "feature_quarantined",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "leviathan.silver-eda-reader-evidence/v1"},
    "table_name": {"type": "string", "pattern": "^silver_"},
    "archetype": {"type": "string", "minLength": 1},
    "row_meaning": {"type": "string", "minLength": 1},
    "source_rows": {"type": ["integer", "null"], "minimum": 0},
    "analysis_rows": {"type": "integer", "minimum": 0},
    "plotted_rows": {"type": ["integer", "null"], "minimum": 0},
    "exactness": {"enum": ["exact", "sampled", "footer-derived"]},
    "source_shape": {"type": "object"},
    "display_policy": {"type": "object"},
    "preview": {"type": "object"},
    "df_info_text": {"type": "string"},
    "column_dictionary": {"type": "array", "items": {"type": "object"}},
    "dashboard_kpis": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["kpi_id", "kind", "label", "status", "value", "detail", "scope", "references"],
        "properties": {
          "kpi_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "status": {"enum": ["evaluated", "not_assessed"]},
          "detail": {"type": "string", "minLength": 1},
          "scope": {"type": "object"},
          "references": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "ordinary_statistics": {"type": "object"},
    "quality_scorecard": {"type": "object"},
    "reader_insights": {"type": "array", "minItems": 3, "maxItems": 10, "items": {"type": "object"}},
    "notable_rows": {"type": "object"},
    "chart_plan": {"type": "object"},
    "pit_summary": {"type": "object"},
    "anti_feature_summary": {"type": "object"},
    "feature_quarantined": {"type": "boolean"},
    "provenance": {"type": "object"},
    "source_aggregates": {"type": "object"}
  },
  "additionalProperties": false
}
