# Keep Docker build contexts small and deterministic.
.git
.gitignore
.pytest_cache
.mypy_cache
.ruff_cache
__pycache__/
*.py[cod]
*.pyo

# Local environments and editor state
.venv/
venv/
.env
.env.*
.vscode/
.idea/

# Local/runtime artifacts
data/
scratch/
logs/
tmp/
*.log
*.tmp

# Agent worktrees + local tool state -- NEVER context. Measured 2026-08-26: 20 full repo checkouts
# under .claude/worktrees (each with its own un-ignored data/ copy -- the root `data/` pattern
# matches only the root) stalled the embedder build's context walk for 25 minutes at ~0 CPU.
# The Dockerfile COPYs only pyproject.toml + src/ + jobs/ + configs/ + scripts/ + sql/.
.claude/
.tmp/
.playwright-mcp/
.kiro/
cursor/
docs/
dist/
build/
reports/

# Test and analysis-only files are not copied by the Dockerfiles.
tests/
notebooks/

# GraphRAG runtime artifacts — regenerated in S3 (EVIDENCE_S3) / reports; never needed inside an image.
# configs/graphrag/evidence/ alone is ~469 MB of inline embedding vectors. The cloud builder reads the small
# config inputs it DOES need (causal/, commodity_hierarchy.yaml, evidence_windows.yaml, vocab) and writes fresh.
configs/graphrag/evidence/
configs/graphrag/eval/
configs/graphrag/pilot/

# OS noise
.DS_Store
Thumbs.db
