{
  "schedule": "unica",
  "family": "unica",
  "wave": 2,
  "cron": "cron(0 12 ? * WED *)",
  "publish_class": "A(annual)+B->A(W4,biweekly)",
  "retrofit_required": true,
  "retrofit_landed": false,
  "promote_mode": "stop_and_notify",
  "auth_mode": "hmac",
  "skip_existing": false,
  "asof": "<aws.scheduler.scheduled-time>",
  "gate_tables": [
    "silver_unica_annual_state",
    "silver_unica_biweekly_release_series",
    "silver_unica_biweekly_season_history"
  ],
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/unica/census.json",
  "gate_jobdef": "leviathan-dev-silver-gate",
  "gate_queue": "leviathan-dev-queue-ondemand",
  "shared_silver_jobdef": "leviathan-dev-b3-flat-silver:4",
  "retry": {
    "maximum_retry_attempts": 3,
    "maximum_event_age_in_seconds": 86400
  },
  "queue": "leviathan-dev-queue-ondemand",
  "chain_shape": "fetch->bronze->silver(annual/state + biweekly)",
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "id": "fetch_unica",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/ingest/fetch_unica.py"
          ],
          "env": {},
          "publishes": false
        },
        {
          "id": "fetch_unica_biweekly",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/ingest/fetch_unica_biweekly.py"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "id": "unica_bronze",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-unica-bronze:1",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/unica_task.py"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "id": "unica_annual_state",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-unica-annual-state:1",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/unica_annual_state_task.py"
          ],
          "env": {},
          "publishes": true,
          "publish_mode": "shadow_canonical"
        },
        {
          "id": "unica_biweekly_silver",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/unica_biweekly_silver_task.py"
          ],
          "env": {},
          "publishes": true,
          "publish_mode": "latest_only"
        }
      ]
    }
  ],
  "notes": "NEEDS Playwright/chromium in the Batch image (unica --discover). Annual/state producer is CLASS-A (shadow_canonical, named jobdef); biweekly producer is CLASS-B latest_only (held until A-W4) -- so the whole family stays DISABLED (promote_mode=stop_and_notify) until the biweekly retrofit lands. Fortnight iteration. silver_unica_corn_ethanol + silver_unica_monthly_ethanol_sales have no direct producer (derived) and are out of this chain's gate."
}
