{
  "schedule": "mpob",
  "family": "mpob",
  "wave": 1,
  "cron": "cron(0 6 10-12 * ? *)",
  "publish_class": "A",
  "retrofit_required": false,
  "retrofit_landed": true,
  "promote_mode": "autonomous",
  "auth_mode": "kms",
  "skip_existing": true,
  "asof": "<aws.scheduler.scheduled-time>",
  "gate_tables": [
    "silver_mpob",
    "silver_mpob_annual"
  ],
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/mpob/census.json",
  "gate_jobdef": "leviathan-dev-silver-gate",
  "gate_queue": "leviathan-dev-queue-ondemand",
  "shared_silver_jobdef": "leviathan-dev-b3-flat-silver",
  "retry": {
    "maximum_retry_attempts": 3,
    "maximum_event_age_in_seconds": 86400
  },
  "queue": "leviathan-dev-queue-ondemand",
  "chain_shape": "fetch->bronze(x2+text)->silver(monthly+annual)",
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "id": "fetch_mpob",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/ingest/fetch_mpob.py"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "id": "mpob_bronze",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-mpob-bronze",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/mpob_task.py"
          ],
          "env": {},
          "publishes": false
        },
        {
          "id": "mpob_overview_bronze",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-mpob-overview-bronze",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/mpob_overview_bronze_task.py"
          ],
          "env": {},
          "publishes": false
        },
        {
          "id": "mpob_overview_text",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-mpob-overview-text",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/mpob_overview_text_task.py"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "id": "mpob_silver",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-mpob-silver",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/mpob_silver_task.py"
          ],
          "env": {},
          "publishes": true,
          "publish_mode": "shadow_canonical"
        },
        {
          "id": "mpob_annual_silver",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-mpob-silver",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/mpob_annual_silver_task.py"
          ],
          "env": {},
          "publishes": true,
          "publish_mode": "shadow_canonical"
        }
      ]
    }
  ],
  "notes": "Fully named jobdefs (bronze x2 + text + monthly/annual silver). --skip-existing; --year cumulative self-heals. | 2026-08-16 (DSG-TAIL A1, owner-ratified): the annual silver leg FOLDED onto leviathan-dev-mpob-silver -- the two jobdefs were spec-identical (image/exec/network/1vCPU/2048) and the SFN overrides the command per task, so leviathan-dev-mpob-annual-silver was destroyed and the family self-promotes through the scalar promote_jobdef below (own-set = {mpob-silver}, the arity lint untouched). jobRoleArn moved to silver-publisher in the same change (kms:Sign). This closes the mixed-vintage promote (shared runner floating vs digest-pinned producers) that burned futures_eod on 2026-08-01 -- the deliberate suite red in test_gen_sfn_inputs.py clears with it.",
  "promote_jobdef": "leviathan-dev-mpob-silver",
  "promote_jobdef_note": "SELF-PROMOTION, same class + same proof as futures_eod, modis_biweekly and fgis: mpob-silver rides the digest-pinned local.worker_fleet_image, so a promote on the shared floating runner would re-derive silver with a DIFFERENT build than the shadow it promotes. Both silver legs (monthly + annual, folded 2026-08-16) run and promote on this one jobdef; jobRoleArn=silver-publisher moved in the same change."
}
