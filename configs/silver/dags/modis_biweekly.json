{
  "schedule": "modis_biweekly",
  "family": "weather",
  "wave": 2,
  "cron": "cron(0 9 ? * MON *)",
  "publish_class": "B->A(W4)",
  "retrofit_required": true,
  "retrofit_landed": false,
  "promote_mode": "stop_and_notify",
  "auth_mode": "hmac",
  "skip_existing": false,
  "asof": "<aws.scheduler.scheduled-time>",
  "gate_tables": [
    "silver_modis_ndvi"
  ],
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/modis_biweekly/census.json",
  "gate_jobdef": "leviathan-dev-silver-gate",
  "gate_queue": "leviathan-dev-queue-ondemand",
  "shared_silver_jobdef": "leviathan-dev-b3-flat-silver:4",
  "retry": {
    "maximum_retry_attempts": 3,
    "maximum_event_age_in_seconds": 86400
  },
  "queue": "leviathan-dev-queue-ondemand",
  "chain_shape": "fetch->r2b(max-run-id)->b2s",
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "id": "fetch_modis_ndvi",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-modis-fetch:1",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/ingest/fetch_modis_ndvi.py"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "id": "modis_ndvi_raw_to_bronze",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-modis-ndvi-raw-to-bronze:1",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/modis_ndvi_raw_to_bronze_task.py"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "id": "modis_ndvi_bronze_to_silver",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-modis-ndvi-bronze-to-silver:1",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/modis_ndvi_bronze_to_silver_task.py"
          ],
          "env": {},
          "publishes": true,
          "publish_mode": "latest_only"
        }
      ]
    }
  ],
  "notes": "fetch_modis_ndvi has NO jobdef (runs on the shared runner override); the chain is run-id keyed, NOT date-keyed. Over-schedule weekly + skip-existing; the fetch resolves missing composites then r2b runs thin-contract (no args): it defaults run_id to the MAX raw partition and group to 'all' (every commodity_group). b2s runs thin-contract too (--commodity all). modis_ndvi bronze_to_silver code is the A-W4 shadow-first publisher, but this descriptor still declares publish_mode=latest_only so the renderer appends NO --publish-mode flag and b2s runs at its dry-run default (held no-op); flip publish_mode to shadow_canonical to arm the CLASS-B shadow+gate canary. Same catalog family (weather) as weather_daily but a SEPARATE biweekly schedule."
}
