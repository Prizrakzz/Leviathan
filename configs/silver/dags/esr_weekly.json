{
  "schedule": "esr_weekly",
  "family": "usda_esr",
  "wave": 3,
  "cron": "cron(0 14 ? * THU *)",
  "publish_class": "A (registered)",
  "retrofit_required": false,
  "retrofit_landed": true,
  "promote_mode": "autonomous",
  "auth_mode": "kms",
  "skip_existing": false,
  "asof": "${ASOF}",
  "gate_tables": [
    "silver_esr",
    "silver_esr_compact"
  ],
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/esr_weekly/census.json",
  "gate_jobdef": "leviathan-dev-evidence-build",
  "gate_queue": "leviathan-dev-queue-ondemand",
  "shared_silver_jobdef": "leviathan-dev-b3-flat-silver:4",
  "retry": {
    "maximum_retry_attempts": 3,
    "maximum_event_age_in_seconds": 86400
  },
  "queue": "leviathan-dev-queue",
  "chain_shape": "fetch->bronze(as_of)->silver_esr_compact",
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "id": "fetch_usda_esr",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-usda-esr-fetch:1",
          "queue": "leviathan-dev-queue",
          "command": [
            "jobs/ingest/fetch_usda_esr.py",
            "--mode",
            "weekly",
            "--skip-existing-s3"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "id": "esr_bronze",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-usda-esr-bronze:2",
          "queue": "leviathan-dev-queue",
          "command": [
            "jobs/batch/esr_task.py"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "id": "esr_bronze_to_silver",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-esr-bronze-to-silver:3",
          "queue": "leviathan-dev-queue",
          "command": [
            "jobs/batch/bronze_to_silver_esr_task.py",
            "--vintage-mode"
          ],
          "env": {},
          "publishes": true,
          "publish_mode": "shadow_canonical"
        }
      ]
    }
  ],
  "target_swap": true,
  "notes": "TARGET-SWAP: repoint the EXISTING live leviathan-dev-esr-weekly-ingest schedule Target from aws-sdk:batch:submitJob to aws-sdk:sfn:startExecution on this chain (no second schedule -- the only way a double-fire could arise). Bronze promotes the as_of vintage; esr silver takes --vintage-mode and --publish-mode (registered per-week as_of); per-week iter (already caught up post-B2)."
}
