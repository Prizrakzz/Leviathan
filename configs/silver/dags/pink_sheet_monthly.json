        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "id": "pink_sheet_bronze",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-world-bank-pink-sheet-bronze:1",
          "queue": "leviathan-dev-queue",
