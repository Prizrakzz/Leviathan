    {
      "name": "silver",
      "tasks": [
        {
          "id": "pink_sheet_silver",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue",
          "command": [
            "jobs/batch/pink_sheet_silver_task.py"
          ],
