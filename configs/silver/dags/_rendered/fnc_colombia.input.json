{
  "asof": "${ASOF}",
  "auth_mode": "kms",
  "family": "fnc_colombia",
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/fnc_colombia/census.json",
  "gate_tables": [
    "silver_fnc_colombia_area_department",
    "silver_fnc_colombia_exports_port_type",
    "silver_fnc_colombia_monthly"
  ],
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_fnc_excel.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "command": [
            "jobs/batch/fnc_excel_task.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-fnc-excel-bronze:3",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "command": [
            "jobs/batch/fnc_colombia_silver_task.py",
            "--publish-mode",
            "shadow"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    }
  ],
  "promote": {
    "mode": "autonomous",
    "tasks": [
      {
        "command": [
          "jobs/batch/fnc_colombia_silver_task.py",
          "--publish-mode",
          "canonical"
        ],
        "env": {},
        "integration": "batch",
        "jobdef": "leviathan-dev-b3-flat-silver:4",
        "queue": "leviathan-dev-queue",
        "role": "leviathan-dev-silver-publisher"
      }
    ]
  }
}
