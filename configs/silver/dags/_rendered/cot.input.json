{
  "asof": "${ASOF}",
  "auth_mode": "hmac",
  "family": "cftc",
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/cot/census.json",
  "gate_tables": [
    "silver_cot"
  ],
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_cftc_cot.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "command": [
            "jobs/batch/cftc_cot_bronze_task.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "command": [
            "jobs/batch/cftc_cot_silver_task.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    }
  ],
  "promote": {
    "mode": "stop_and_notify",
    "tasks": []
  }
}
