{
  "asof": "${ASOF}",
  "auth_mode": "kms",
  "family": "usda_esr",
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/esr_weekly/census.json",
  "gate_tables": [
    "silver_esr",
    "silver_esr_compact"
  ],
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_usda_esr.py",
            "--mode",
            "weekly",
            "--skip-existing-s3"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-usda-esr-fetch:1",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "command": [
            "jobs/batch/esr_task.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-usda-esr-bronze:2",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "command": [
            "jobs/batch/bronze_to_silver_esr_task.py",
            "--vintage-mode",
            "--publish-mode",
            "shadow"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-esr-bronze-to-silver:3",
          "queue": "leviathan-dev-queue"
        }
      ]
    }
  ],
  "promote": {
    "mode": "autonomous",
    "tasks": [
      {
        "command": [
          "jobs/batch/bronze_to_silver_esr_task.py",
          "--vintage-mode",
          "--publish-mode",
          "canonical"
        ],
        "env": {},
        "integration": "batch",
        "jobdef": "leviathan-dev-esr-bronze-to-silver:3",
        "queue": "leviathan-dev-queue",
        "role": "leviathan-dev-silver-publisher"
      }
    ]
  }
}
