{
  "asof": "${ASOF}",
  "auth_mode": "kms",
  "family": "usda_wap",
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/wap/census.json",
  "gate_tables": [
    "silver_wap_table01",
    "silver_wap_table01_revisions"
  ],
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_usda_wap.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-usda-wap-raw-backfill:1",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "command": [
            "jobs/batch/wap_task.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "command": [
            "-m",
            "jobs.batch.wap_silver_task",
            "--publish-mode",
            "shadow"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    }
  ],
  "promote": {
    "mode": "autonomous",
    "tasks": [
      {
        "command": [
          "-m",
          "jobs.batch.wap_silver_task",
          "--publish-mode",
          "canonical"
        ],
        "env": {},
        "integration": "batch",
        "jobdef": "leviathan-dev-b3-flat-silver:4",
        "queue": "leviathan-dev-queue",
        "role": "leviathan-dev-silver-publisher"
      }
    ]
  }
}
