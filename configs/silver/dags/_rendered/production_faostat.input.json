{
  "asof": "${ASOF}",
  "auth_mode": "kms",
  "family": "faostat",
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/production_faostat/census.json",
  "gate_tables": [
    "silver_production"
  ],
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "command": [
            "jobs/ingest/upload_faostat.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "command": [],
          "env": {},
          "glue_job": "leviathan-dev-raw-to-bronze-faostat",
          "integration": "glue"
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "command": [],
          "env": {},
          "glue_job": "leviathan-dev-bronze-to-silver-faostat",
          "integration": "glue"
        }
      ]
    }
  ],
  "promote": {
    "mode": "post_publish_audit",
    "tasks": []
  }
}
