{
  "asof": "<aws.scheduler.scheduled-time>",
  "auth_mode": "kms",
  "family": "futures_eod",
  "gate": {
    "command": [
      "-m",
      "jobs.audit.silver_rebuild_gate",
      "--tables",
      "silver_futures_eod",
      "--asof",
      "<aws.scheduler.scheduled-time>",
      "--baseline-uri",
      "s3://leviathan-dev-shahem-001/cascade_census/rolling/futures_eod_databento/census.json"
    ],
    "jobdef": "leviathan-dev-silver-gate",
    "queue": "leviathan-dev-queue-ondemand"
  },
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/futures_eod_databento/census.json",
  "gate_tables": [
    "silver_futures_eod"
  ],
  "phases": {
    "bronze": {
      "tasks": []
    },
    "fetch": {
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_databento_eod.py",
            "--mode",
            "incremental",
            "--lookback-days",
            "5"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-databento-fetch",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    },
    "silver": {
      "tasks": [
        {
          "command": [
            "jobs/batch/futures_eod_task.py",
            "--mode",
            "incremental",
            "--lookback-days",
            "5",
            "--publish-mode",
            "shadow"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-futures-eod-silver",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    }
  },
  "promote": {
    "mode": "stop_and_notify",
    "tasks": []
  }
}
