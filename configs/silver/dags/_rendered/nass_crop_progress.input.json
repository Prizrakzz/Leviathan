{
  "asof": "<aws.scheduler.scheduled-time>",
  "auth_mode": "hmac",
  "family": "usda_nass",
  "gate": {
    "command": [
      "-m",
      "jobs.audit.silver_rebuild_gate",
      "--tables",
      "silver_nass_annual,silver_nass_crop_progress",
      "--asof",
      "<aws.scheduler.scheduled-time>",
      "--baseline-uri",
      "s3://leviathan-dev-shahem-001/cascade_census/rolling/nass_crop_progress/census.json"
    ],
    "jobdef": "leviathan-dev-silver-gate",
    "queue": "leviathan-dev-queue-ondemand"
  },
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/nass_crop_progress/census.json",
  "gate_tables": [
    "silver_nass_annual",
    "silver_nass_crop_progress"
  ],
  "phases": {
    "bronze": {
      "tasks": [
        {
          "command": [
            "jobs/batch/nass_task.py",
            "--series",
            "all"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-usda-nass-bronze",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    },
    "fetch": {
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_usda_nass.py"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    },
    "silver": {
      "tasks": [
        {
          "command": [
            "jobs/batch/nass_crop_progress_silver_task.py"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver",
          "queue": "leviathan-dev-queue-ondemand"
        },
        {
          "command": [
            "jobs/batch/nass_annual_silver_task.py"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    }
  },
  "promote": {
    "mode": "stop_and_notify",
    "tasks": []
  }
}
