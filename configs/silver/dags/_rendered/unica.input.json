{
  "asof": "${ASOF}",
  "auth_mode": "hmac",
  "family": "unica",
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/unica/census.json",
  "gate_tables": [
    "silver_unica_annual_state",
    "silver_unica_biweekly_release_series",
    "silver_unica_biweekly_season_history"
  ],
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_unica.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        },
        {
          "command": [
            "jobs/ingest/fetch_unica_biweekly.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "command": [
            "jobs/batch/unica_task.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-unica-bronze:1",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "command": [
            "jobs/batch/unica_annual_state_task.py",
            "--publish-mode",
            "shadow"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-unica-annual-state:1",
          "queue": "leviathan-dev-queue"
        },
        {
          "command": [
            "jobs/batch/unica_biweekly_silver_task.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    }
  ],
  "promote": {
    "mode": "stop_and_notify",
    "tasks": []
  }
}
