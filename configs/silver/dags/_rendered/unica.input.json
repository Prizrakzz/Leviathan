{
  "asof": "<aws.scheduler.scheduled-time>",
  "auth_mode": "hmac",
  "family": "unica",
  "gate": {
    "command": [
      "-m",
      "jobs.audit.silver_rebuild_gate",
      "--tables",
      "silver_unica_annual_state,silver_unica_biweekly_release_series,silver_unica_biweekly_season_history",
      "--asof",
      "<aws.scheduler.scheduled-time>",
      "--baseline-uri",
      "s3://leviathan-dev-shahem-001/cascade_census/rolling/unica/census.json"
    ],
    "jobdef": "leviathan-dev-silver-gate",
    "queue": "leviathan-dev-queue-ondemand"
  },
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/unica/census.json",
  "gate_tables": [
    "silver_unica_annual_state",
    "silver_unica_biweekly_release_series",
    "silver_unica_biweekly_season_history"
  ],
  "phases": {
    "bronze": {
      "tasks": [
        {
          "command": [
            "jobs/batch/unica_task.py"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-unica-bronze",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    },
    "fetch": {
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_unica.py"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver",
          "queue": "leviathan-dev-queue-ondemand"
        },
        {
          "command": [
            "jobs/ingest/fetch_unica_biweekly.py",
            "--discover",
            "--current-season",
            "--asof",
            "<aws.scheduler.scheduled-time>"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    },
    "silver": {
      "tasks": [
        {
          "command": [
            "jobs/batch/unica_annual_state_task.py",
            "--publish-mode",
            "shadow"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-unica-annual-state",
          "queue": "leviathan-dev-queue-ondemand"
        },
        {
          "command": [
            "jobs/batch/unica_biweekly_silver_task.py"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    }
  },
  "promote": {
    "mode": "stop_and_notify",
    "tasks": []
  }
}
