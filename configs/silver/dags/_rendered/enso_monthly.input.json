{
  "asof": "${ASOF}",
  "auth_mode": "kms",
  "family": "noaa_climate",
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/enso_monthly/census.json",
  "gate_tables": [
    "silver_noaa_iod",
    "silver_noaa_oni"
  ],
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_noaa_oni.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        },
        {
          "command": [
            "jobs/ingest/fetch_noaa_iod.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "command": [
            "jobs/batch/noaa_oni_task.py",
            "--publish-mode",
            "shadow"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        },
        {
          "command": [
            "-m",
            "jobs.batch.noaa_iod_task",
            "--publish-mode",
            "shadow"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    }
  ],
  "promote": {
    "mode": "autonomous",
    "tasks": [
      {
        "command": [
          "jobs/batch/noaa_oni_task.py",
          "--publish-mode",
          "canonical"
        ],
        "env": {},
        "integration": "batch",
        "jobdef": "leviathan-dev-b3-flat-silver:4",
        "queue": "leviathan-dev-queue",
        "role": "leviathan-dev-silver-publisher"
      },
      {
        "command": [
          "-m",
          "jobs.batch.noaa_iod_task",
          "--publish-mode",
          "canonical"
        ],
        "env": {},
        "integration": "batch",
        "jobdef": "leviathan-dev-b3-flat-silver:4",
        "queue": "leviathan-dev-queue",
        "role": "leviathan-dev-silver-publisher"
      }
    ]
  }
}
