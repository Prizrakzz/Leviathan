{
  "asof": "<aws.scheduler.scheduled-time>",
  "auth_mode": "hmac",
  "family": "usda_fgis",
  "gate": {
    "command": [
      "-m",
      "jobs.audit.silver_rebuild_gate",
      "--tables",
      "silver_fgis",
      "--asof",
      "<aws.scheduler.scheduled-time>",
      "--baseline-uri",
      "s3://leviathan-dev-shahem-001/cascade_census/rolling/fgis/census.json"
    ],
    "jobdef": "leviathan-dev-silver-gate",
    "queue": "leviathan-dev-queue-ondemand"
  },
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/fgis/census.json",
  "gate_tables": [
    "silver_fgis"
  ],
  "phases": {
    "bronze": {
      "tasks": [
        {
          "command": [
            "jobs/batch/fgis_task.py"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-usda-fgis-bronze",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    },
    "fetch": {
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_usda_fgis_export_inspections.py"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    },
    "silver": {
      "tasks": [
        {
          "command": [
            "jobs/batch/fgis_silver_task.py"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-fgis-silver",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    }
  },
  "promote": {
    "mode": "stop_and_notify",
    "tasks": []
  }
}
