{
  "asof": "<aws.scheduler.scheduled-time>",
  "auth_mode": "kms",
  "family": "icco",
  "gate": {
    "command": [
      "-m",
      "jobs.audit.silver_rebuild_gate",
      "--tables",
      "silver_icco_cocoa",
      "--asof",
      "<aws.scheduler.scheduled-time>",
      "--baseline-uri",
      "s3://leviathan-dev-shahem-001/cascade_census/rolling/icco_cocoa/census.json"
    ],
    "jobdef": "leviathan-dev-silver-gate",
    "queue": "leviathan-dev-queue-ondemand"
  },
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/icco_cocoa/census.json",
  "gate_tables": [
    "silver_icco_cocoa"
  ],
  "phases": {
    "bronze": {
      "tasks": []
    },
    "fetch": {
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_icco_qbcs_summary.py"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    },
    "silver": {
      "tasks": [
        {
          "command": [
            "jobs/batch/icco_cocoa_task.py",
            "--publish-mode",
            "shadow"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    }
  },
  "promote": {
    "mode": "autonomous",
    "tasks": [
      {
        "command": [
          "jobs/batch/icco_cocoa_task.py",
          "--publish-mode",
          "canonical"
        ],
        "env": [
          {
            "Name": "LEVIATHAN_APPROVAL_MODE",
            "Value": "kms"
          },
          {
            "Name": "LEVIATHAN_KMS_KEY_ID",
            "Value": "alias/leviathan-dev-publish-signer"
          }
        ],
        "integration": "batch",
        "jobdef": "leviathan-dev-silver-publisher-runner",
        "queue": "leviathan-dev-queue-ondemand"
      }
    ]
  }
}
