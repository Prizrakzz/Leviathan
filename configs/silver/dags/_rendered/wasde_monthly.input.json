{
  "asof": "<aws.scheduler.scheduled-time>",
  "auth_mode": "kms",
  "family": "usda_wasde",
  "gate": {
    "command": [
      "-m",
      "jobs.audit.silver_rebuild_gate",
      "--tables",
      "silver_wasde",
      "--asof",
      "<aws.scheduler.scheduled-time>",
      "--baseline-uri",
      "s3://leviathan-dev-shahem-001/cascade_census/rolling/wasde_monthly/census.json"
    ],
    "jobdef": "leviathan-dev-silver-gate",
    "queue": "leviathan-dev-queue-ondemand"
  },
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/wasde_monthly/census.json",
  "gate_tables": [
    "silver_wasde"
  ],
  "phases": {
    "bronze": {
      "tasks": [
        {
          "command": [
            "jobs/batch/wasde_bronze_modern_task.py"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-wasde-bronze-modern",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    },
    "fetch": {
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_usda_wasde.py",
            "--refresh-manifest",
            "--discover-pages",
            "1",
            "--skip-existing-s3"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-usda-wasde-raw-backfill",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    },
    "silver": {
      "tasks": [
        {
          "command": [
            "jobs/batch/wasde_silver_task.py",
            "--since-days",
            "75",
            "--seed-from",
            "2010-01-01",
            "--publish-mode",
            "shadow"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-wasde-silver",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    }
  },
  "promote": {
    "mode": "autonomous",
    "tasks": [
      {
        "command": [
          "jobs/batch/wasde_silver_task.py",
          "--since-days",
          "75",
          "--seed-from",
          "2010-01-01",
          "--publish-mode",
          "canonical"
        ],
        "env": [
          {
            "Name": "LEVIATHAN_APPROVAL_MODE",
            "Value": "kms"
          },
          {
            "Name": "LEVIATHAN_KMS_KEY_ID",
            "Value": "alias/leviathan-dev-publish-signer"
          }
        ],
        "integration": "batch",
        "jobdef": "leviathan-dev-silver-publisher-runner",
        "queue": "leviathan-dev-queue-ondemand"
      }
    ]
  }
}
