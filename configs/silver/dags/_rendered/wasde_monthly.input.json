{
  "asof": "${ASOF}",
  "auth_mode": "kms",
  "family": "usda_wasde",
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/wasde_monthly/census.json",
  "gate_tables": [
    "silver_wasde"
  ],
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_usda_wasde.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-usda-wasde-raw-backfill:1",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "command": [
            "jobs/batch/wasde_bronze_modern_task.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-wasde-bronze-modern:1",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "command": [
            "jobs/batch/wasde_silver_task.py",
            "--release-date",
            "${RELEASE_DATE}",
            "--publish-mode",
            "shadow"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-wasde-silver:2",
          "queue": "leviathan-dev-queue"
        }
      ]
    }
  ],
  "promote": {
    "mode": "autonomous",
    "tasks": [
      {
        "command": [
          "jobs/batch/wasde_silver_task.py",
          "--release-date",
          "${RELEASE_DATE}",
          "--publish-mode",
          "canonical"
        ],
        "env": {},
        "integration": "batch",
        "jobdef": "leviathan-dev-wasde-silver:2",
        "queue": "leviathan-dev-queue",
        "role": "leviathan-dev-silver-publisher"
      }
    ]
  }
}
