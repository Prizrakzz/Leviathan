{
  "asof": "${ASOF}",
  "auth_mode": "kms",
  "family": "conab",
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/production_conab/census.json",
  "gate_tables": [
    "silver_conab_coffee"
  ],
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "command": [
            "jobs/ingest/discover_conab_bulletin_xls.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        },
        {
          "command": [
            "jobs/ingest/fetch_conab.py",
            "--years",
            "${YEARS}"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "command": [
            "jobs/batch/conab_xls_task.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-conab-xls-bronze:1",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "command": [
            "jobs/batch/conab_coffee_silver_task.py",
            "--publish-mode",
            "shadow"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    }
  ],
  "promote": {
    "mode": "autonomous",
    "tasks": [
      {
        "command": [
          "jobs/batch/conab_coffee_silver_task.py",
          "--publish-mode",
          "canonical"
        ],
        "env": {},
        "integration": "batch",
        "jobdef": "leviathan-dev-b3-flat-silver:4",
        "queue": "leviathan-dev-queue",
        "role": "leviathan-dev-silver-publisher"
      }
    ]
  }
}
