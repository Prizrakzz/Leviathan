{
  "asof": "${ASOF}",
  "auth_mode": "kms",
  "family": "sagis",
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/sagis_weekly/census.json",
  "gate_tables": [
    "silver_sagis_cec",
    "silver_sagis_weekly_deliveries",
    "silver_sagis_weekly_exports"
  ],
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_sagis_cec.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-sagis-cec-raw-backfill:2",
          "queue": "leviathan-dev-queue"
        },
        {
          "command": [
            "jobs/ingest/fetch_sagis_swb.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        },
        {
          "command": [
            "jobs/ingest/fetch_sagis_weekly.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "command": [
            "jobs/batch/sagis_cec_silver_task.py",
            "--publish-mode",
            "shadow"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        },
        {
          "command": [
            "jobs/batch/sagis_weekly_exports_silver_task.py",
            "--publish-mode",
            "shadow"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        },
        {
          "command": [
            "-m",
            "jobs.batch.sagis_deliveries_task",
            "--publish-mode",
            "shadow"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    }
  ],
  "promote": {
    "mode": "autonomous",
    "tasks": [
      {
        "command": [
          "jobs/batch/sagis_cec_silver_task.py",
          "--publish-mode",
          "canonical"
        ],
        "env": {},
        "integration": "batch",
        "jobdef": "leviathan-dev-b3-flat-silver:4",
        "queue": "leviathan-dev-queue",
        "role": "leviathan-dev-silver-publisher"
      },
      {
        "command": [
          "jobs/batch/sagis_weekly_exports_silver_task.py",
          "--publish-mode",
          "canonical"
        ],
        "env": {},
        "integration": "batch",
        "jobdef": "leviathan-dev-b3-flat-silver:4",
        "queue": "leviathan-dev-queue",
        "role": "leviathan-dev-silver-publisher"
      },
      {
        "command": [
          "-m",
          "jobs.batch.sagis_deliveries_task",
          "--publish-mode",
          "canonical"
        ],
        "env": {},
        "integration": "batch",
        "jobdef": "leviathan-dev-b3-flat-silver:4",
        "queue": "leviathan-dev-queue",
        "role": "leviathan-dev-silver-publisher"
      }
    ]
  }
}
