{
  "asof": "${ASOF}",
  "auth_mode": "hmac",
  "family": "usda_psd",
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/psd_monthly/census.json",
  "gate_tables": [
    "silver_psd"
  ],
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_usda_psd.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "command": [
            "jobs/batch/psd_task.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-usda-psd-bronze:1",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "command": [
            "-m",
            "jobs.batch.psd_silver_task"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    }
  ],
  "promote": {
    "mode": "stop_and_notify",
    "tasks": []
  }
}
