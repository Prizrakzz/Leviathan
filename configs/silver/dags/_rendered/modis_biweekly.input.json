{
  "asof": "<aws.scheduler.scheduled-time>",
  "auth_mode": "hmac",
  "family": "weather",
  "gate": {
    "command": [
      "-m",
      "jobs.audit.silver_rebuild_gate",
      "--tables",
      "silver_modis_ndvi",
      "--asof",
      "<aws.scheduler.scheduled-time>",
      "--baseline-uri",
      "s3://leviathan-dev-shahem-001/cascade_census/rolling/modis_biweekly/census.json"
    ],
    "jobdef": "leviathan-dev-silver-gate",
    "queue": "leviathan-dev-queue-ondemand"
  },
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/modis_biweekly/census.json",
  "gate_tables": [
    "silver_modis_ndvi"
  ],
  "phases": {
    "bronze": {
      "tasks": [
        {
          "command": [
            "jobs/batch/modis_ndvi_raw_to_bronze_task.py"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-modis-ndvi-raw-to-bronze",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    },
    "fetch": {
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_modis_ndvi.py"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-modis-fetch",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    },
    "silver": {
      "tasks": [
        {
          "command": [
            "jobs/batch/modis_ndvi_bronze_to_silver_task.py",
            "--publish-mode",
            "shadow"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-modis-ndvi-bronze-to-silver",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    }
  },
  "promote": {
    "mode": "stop_and_notify",
    "tasks": []
  }
}
