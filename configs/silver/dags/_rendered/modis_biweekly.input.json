{
  "asof": "${ASOF}",
  "auth_mode": "hmac",
  "family": "weather",
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/modis_biweekly/census.json",
  "gate_tables": [
    "silver_modis_ndvi"
  ],
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_modis_ndvi.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "command": [
            "jobs/batch/modis_ndvi_raw_to_bronze_task.py",
            "--run-id",
            "${RUN_ID}"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-modis-ndvi-raw-to-bronze:1",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "command": [
            "jobs/batch/modis_ndvi_bronze_to_silver_task.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-modis-ndvi-bronze-to-silver:1",
          "queue": "leviathan-dev-queue"
        }
      ]
    }
  ],
  "promote": {
    "mode": "stop_and_notify",
    "tasks": []
  }
}
