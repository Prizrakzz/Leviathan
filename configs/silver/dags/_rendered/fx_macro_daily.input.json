{
  "asof": "${ASOF}",
  "auth_mode": "kms",
  "family": "fred",
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/fx_macro_daily/census.json",
  "gate_tables": [
    "silver_fred_fx"
  ],
  "phases": [
    {
      "name": "silver",
      "tasks": [
        {
          "command": [
            "-m",
            "jobs.batch.frankfurter_fx_task",
            "--start",
            "${START}",
            "--end",
            "${END}",
            "--publish-mode",
            "shadow"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    }
  ],
  "promote": {
    "mode": "autonomous",
    "tasks": [
      {
        "command": [
          "-m",
          "jobs.batch.frankfurter_fx_task",
          "--start",
          "${START}",
          "--end",
          "${END}",
          "--publish-mode",
          "canonical"
        ],
        "env": {},
        "integration": "batch",
        "jobdef": "leviathan-dev-b3-flat-silver:4",
        "queue": "leviathan-dev-queue",
        "role": "leviathan-dev-silver-publisher"
      }
    ]
  }
}
