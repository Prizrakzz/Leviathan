{
  "asof": "<aws.scheduler.scheduled-time>",
  "auth_mode": "hmac",
  "family": "futures",
  "gate": {
    "command": [
      "-m",
      "jobs.audit.silver_rebuild_gate",
      "--tables",
      "silver_futures_prices",
      "--asof",
      "<aws.scheduler.scheduled-time>",
      "--baseline-uri",
      "s3://leviathan-dev-shahem-001/cascade_census/rolling/futures_prices/census.json"
    ],
    "jobdef": "leviathan-dev-silver-gate",
    "queue": "leviathan-dev-queue-ondemand"
  },
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/futures_prices/census.json",
  "gate_tables": [
    "silver_futures_prices"
  ],
  "phases": {
    "bronze": {
      "tasks": []
    },
    "fetch": {
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_yfinance_futures.py"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    },
    "silver": {
      "tasks": [
        {
          "command": [
            "jobs/batch/yfinance_futures_task.py",
            "--force-overwrite"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver",
          "queue": "leviathan-dev-queue-ondemand"
        },
        {
          "command": [
            "-m",
            "jobs.batch.quandl_chris_task",
            "--publish-mode",
            "shadow"
          ],
          "env": [],
          "integration": "batch",
          "jobdef": "leviathan-dev-quandl-chris",
          "queue": "leviathan-dev-queue-ondemand"
        }
      ]
    }
  },
  "promote": {
    "mode": "stop_and_notify",
    "tasks": []
  }
}
