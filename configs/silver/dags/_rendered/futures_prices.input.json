{
  "asof": "${ASOF}",
  "auth_mode": "hmac",
  "family": "futures",
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/futures_prices/census.json",
  "gate_tables": [
    "silver_futures_prices"
  ],
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "command": [
            "jobs/ingest/fetch_yfinance_futures.py"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "command": [
            "jobs/batch/yfinance_futures_task.py",
            "--force-overwrite"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        },
        {
          "command": [
            "-m",
            "jobs.batch.quandl_chris_task"
          ],
          "env": {},
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue"
        }
      ]
    }
  ],
  "promote": {
    "mode": "stop_and_notify",
    "tasks": []
  }
}
