{
  "schedule": "nass_crop_progress",
  "family": "usda_nass",
  "wave": 2,
  "cron": "cron(0 9 ? * TUE *)",
  "publish_class": "B->A(W4)",
  "retrofit_required": true,
  "retrofit_landed": false,
  "promote_mode": "stop_and_notify",
  "auth_mode": "hmac",
  "skip_existing": false,
  "asof": "<aws.scheduler.scheduled-time>",
  "gate_tables": [
    "silver_nass_annual",
    "silver_nass_crop_progress"
  ],
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/nass_crop_progress/census.json",
  "gate_jobdef": "leviathan-dev-silver-gate",
  "gate_queue": "leviathan-dev-queue-ondemand",
  "shared_silver_jobdef": "leviathan-dev-b3-flat-silver:4",
  "retry": {
    "maximum_retry_attempts": 3,
    "maximum_event_age_in_seconds": 86400
  },
  "queue": "leviathan-dev-queue-ondemand",
  "chain_shape": "fetch->bronze(--series)->silver x2 fan-out",
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "id": "fetch_usda_nass",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/ingest/fetch_usda_nass.py"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "id": "nass_bronze",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-usda-nass-bronze:3",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/nass_task.py",
            "--series"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "id": "nass_crop_progress_silver",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/nass_crop_progress_silver_task.py"
          ],
          "env": {},
          "publishes": true,
          "publish_mode": "latest_only"
        },
        {
          "id": "nass_annual_silver",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/nass_annual_silver_task.py"
          ],
          "env": {},
          "publishes": true,
          "publish_mode": "latest_only"
        }
      ]
    }
  ],
  "notes": "QuickStats full series in one run covers BOTH crop_progress and annual (no separate annual schedule); bronze --series. Year-round weekly, self-healing. Both silver producers are CLASS-B latest-only; held DISABLED until the A-W4 retrofit."
}
