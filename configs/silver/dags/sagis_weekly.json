{
  "schedule": "sagis_weekly",
  "family": "sagis",
  "wave": 1,
  "cron": "cron(0 12 ? * FRI *)",
  "publish_class": "A",
  "retrofit_required": false,
  "retrofit_landed": true,
  "promote_mode": "autonomous",
  "auth_mode": "kms",
  "skip_existing": false,
  "asof": "${ASOF}",
  "gate_tables": [
    "silver_sagis_cec",
    "silver_sagis_weekly_deliveries",
    "silver_sagis_weekly_exports"
  ],
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/sagis_weekly/census.json",
  "gate_jobdef": "leviathan-dev-evidence-build",
  "gate_queue": "leviathan-dev-queue-ondemand",
  "shared_silver_jobdef": "leviathan-dev-b3-flat-silver:4",
  "retry": {
    "maximum_retry_attempts": 3,
    "maximum_event_age_in_seconds": 86400
  },
  "queue": "leviathan-dev-queue",
  "chain_shape": "fetch->bronze(shared parser)->silver x3",
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "id": "fetch_sagis_cec",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-sagis-cec-raw-backfill:2",
          "queue": "leviathan-dev-queue",
          "command": [
            "jobs/ingest/fetch_sagis_cec.py"
          ],
          "env": {},
          "publishes": false
        },
        {
          "id": "fetch_sagis_swb",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue",
          "command": [
            "jobs/ingest/fetch_sagis_swb.py"
          ],
          "env": {},
          "publishes": false
        },
        {
          "id": "fetch_sagis_weekly",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue",
          "command": [
            "jobs/ingest/fetch_sagis_weekly.py"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "id": "sagis_cec_silver",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue",
          "command": [
            "jobs/batch/sagis_cec_silver_task.py"
          ],
          "env": {},
          "publishes": true,
          "publish_mode": "shadow_canonical"
        },
        {
          "id": "sagis_weekly_exports_silver",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue",
          "command": [
            "jobs/batch/sagis_weekly_exports_silver_task.py"
          ],
          "env": {},
          "publishes": true,
          "publish_mode": "shadow_canonical"
        },
        {
          "id": "sagis_deliveries",
          "invocation_form": "m",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue",
          "command": [
            "-m",
            "jobs.batch.sagis_deliveries_task"
          ],
          "env": {},
          "publishes": true,
          "publish_mode": "shadow_canonical"
        }
      ]
    }
  ],
  "notes": "discover+skip self-heals. Three silver producers; sagis_deliveries is module form [m]. fetch_sagis_cec runs on the named cec raw-backfill jobdef, swb/weekly on the shared runner."
}
