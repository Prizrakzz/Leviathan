{
  "schedule": "fnc_colombia",
  "family": "fnc_colombia",
  "wave": 1,
  "cron": "cron(0 12 15 * ? *)",
  "publish_class": "A",
  "retrofit_required": false,
  "retrofit_landed": true,
  "promote_mode": "autonomous",
  "auth_mode": "kms",
  "skip_existing": false,
  "asof": "${ASOF}",
  "gate_tables": [
    "silver_fnc_colombia_area_department",
    "silver_fnc_colombia_exports_port_type",
    "silver_fnc_colombia_monthly"
  ],
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/fnc_colombia/census.json",
  "gate_jobdef": "leviathan-dev-evidence-build",
  "gate_queue": "leviathan-dev-queue-ondemand",
  "shared_silver_jobdef": "leviathan-dev-b3-flat-silver:4",
  "retry": {
    "maximum_retry_attempts": 3,
    "maximum_event_age_in_seconds": 86400
  },
  "queue": "leviathan-dev-queue",
  "chain_shape": "fetch->bronze->silver",
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "id": "fetch_fnc_excel",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue",
          "command": [
            "jobs/ingest/fetch_fnc_excel.py"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "id": "fnc_excel_bronze",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-fnc-excel-bronze:3",
          "queue": "leviathan-dev-queue",
          "command": [
            "jobs/batch/fnc_excel_task.py"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "id": "fnc_colombia_silver",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue",
          "command": [
            "jobs/batch/fnc_colombia_silver_task.py"
          ],
          "env": {},
          "publishes": true,
          "publish_mode": "shadow_canonical"
        }
      ]
    }
  ],
  "notes": "Monthly. One silver producer emits all three fnc tables (area_department, exports_port_type, monthly); bronze is a named jobdef."
}
