{
  "schedule": "wasde_monthly",
  "family": "usda_wasde",
  "wave": 3,
  "cron": "cron(0 18 8-13 * ? *)",
  "publish_class": "A (registered)",
  "retrofit_required": false,
  "retrofit_landed": true,
  "promote_mode": "autonomous",
  "auth_mode": "kms",
  "skip_existing": true,
  "asof": "<aws.scheduler.scheduled-time>",
  "gate_tables": [
    "silver_wasde"
  ],
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/wasde_monthly/census.json",
  "gate_jobdef": "leviathan-dev-silver-gate",
  "gate_queue": "leviathan-dev-queue-ondemand",
  "shared_silver_jobdef": "leviathan-dev-b3-flat-silver",
  "retry": {
    "maximum_retry_attempts": 3,
    "maximum_event_age_in_seconds": 86400
  },
  "queue": "leviathan-dev-queue-ondemand",
  "chain_shape": "fetch->bronze_modern->silver(per release_date)",
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "id": "fetch_usda_wasde",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-usda-wasde-raw-backfill",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/ingest/fetch_usda_wasde.py",
            "--refresh-manifest",
            "--discover-pages",
            "1",
            "--skip-existing-s3"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "id": "wasde_bronze_modern",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-wasde-bronze-modern",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/wasde_bronze_modern_task.py"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "id": "wasde_silver",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-wasde-silver",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/wasde_silver_task.py",
            "--since-days",
            "75",
            "--seed-from",
            "2010-01-01"
          ],
          "env": {},
          "publishes": true,
          "publish_mode": "shadow_canonical"
        }
      ]
    }
  ],
  "per_release_date": true,
  "notes": "FETCH: --refresh-manifest --discover-pages 1 merges the esmis archive head into the static manifest (a release absent from configs/sources/usda_wasde_manifest.yaml is UNREACHABLE -- opaque node ids in the URL -- which is why 2026-08-12 never landed), then --skip-existing-s3 makes the fire idempotent (source_url-aware, so v2 corrections still re-fetch). SILVER: --since-days 75 is the INCREMENTAL publish window (was: unbounded, republishing all 624 bronze releases every fire and dying on the 1985-06-10 F034 conflict); --seed-from 2010-01-01 is a FROZEN floor -- it matches the BF-W2 canonical publish, so release_sequence stays continuous with every partition already written. Registered per release_date."
}
