{
  "schedule": "production_conab",
  "family": "conab",
  "wave": 3,
  "cron": "cron(0 6 1 * ? *)",
  "publish_class": "A",
  "retrofit_required": false,
  "retrofit_landed": true,
  "promote_mode": "autonomous",
  "auth_mode": "kms",
  "skip_existing": false,
  "asof": "<aws.scheduler.scheduled-time>",
  "gate_tables": [
    "silver_conab_coffee"
  ],
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/production_conab/census.json",
  "gate_jobdef": "leviathan-dev-silver-gate",
  "gate_queue": "leviathan-dev-queue-ondemand",
  "shared_silver_jobdef": "leviathan-dev-b3-flat-silver:4",
  "retry": {
    "maximum_retry_attempts": 3,
    "maximum_event_age_in_seconds": 86400
  },
  "queue": "leviathan-dev-queue-ondemand",
  "chain_shape": "fetch->bronze->silver_conab_coffee",
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "id": "discover_conab_bulletin_xls",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/ingest/discover_conab_bulletin_xls.py"
          ],
          "env": {},
          "publishes": false
        },
        {
          "id": "fetch_conab",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/ingest/fetch_conab.py",
            "--years",
            "${YEARS}"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "id": "conab_xls_bronze",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-conab-xls-bronze:1",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/conab_xls_task.py"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "id": "conab_coffee_silver",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver:4",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/conab_coffee_silver_task.py"
          ],
          "env": {},
          "publishes": true,
          "publish_mode": "shadow_canonical"
        }
      ]
    }
  ],
  "discovery_first": true,
  "notes": "MANIFEST-DRIVEN, not auto-discovering: discover_conab_bulletin_xls MUST be the first fetch task or a scheduled run never picks up a new coffee survey (the DAG freezes). Per-year --years."
}
