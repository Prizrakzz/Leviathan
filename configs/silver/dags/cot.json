{
  "schedule": "cot",
  "family": "cftc",
  "wave": 2,
  "cron": "cron(30 20 ? * FRI *)",
  "publish_class": "B->A(W4)",
  "retrofit_required": true,
  "retrofit_landed": false,
  "promote_mode": "stop_and_notify",
  "auth_mode": "hmac",
  "skip_existing": false,
  "asof": "<aws.scheduler.scheduled-time>",
  "gate_tables": [
    "silver_cot"
  ],
  "gate_baseline_uri": "s3://leviathan-dev-shahem-001/cascade_census/rolling/cot/census.json",
  "gate_jobdef": "leviathan-dev-silver-gate",
  "gate_queue": "leviathan-dev-queue-ondemand",
  "shared_silver_jobdef": "leviathan-dev-b3-flat-silver",
  "retry": {
    "maximum_retry_attempts": 3,
    "maximum_event_age_in_seconds": 86400
  },
  "queue": "leviathan-dev-queue-ondemand",
  "chain_shape": "fetch->bronze->silver_cot",
  "phases": [
    {
      "name": "fetch",
      "tasks": [
        {
          "id": "fetch_cftc_cot",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/ingest/fetch_cftc_cot.py",
            "--mode",
            "weekly"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "bronze",
      "tasks": [
        {
          "id": "cftc_cot_bronze",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/cftc_cot_bronze_task.py"
          ],
          "env": {},
          "publishes": false
        }
      ]
    },
    {
      "name": "silver",
      "tasks": [
        {
          "id": "cftc_cot_silver",
          "invocation_form": "s",
          "integration": "batch",
          "jobdef": "leviathan-dev-b3-flat-silver",
          "queue": "leviathan-dev-queue-ondemand",
          "command": [
            "jobs/batch/cftc_cot_silver_task.py"
          ],
          "env": {},
          "publishes": true,
          "publish_mode": "latest_only"
        }
      ]
    }
  ],
  "one_off_backfill": "--mode backfill --end-year 2026",
  "gate_id": "G6",
  "notes": "CLASS-B latest-only until the A-W4 shadow-first retrofit lands; held DISABLED (promote_mode=stop_and_notify) until retrofit_landed. GATED one-off (G6) '--mode backfill --end-year 2026' through shadow->gate->canonical BEFORE the weekly schedule is enabled (weekly mode never backfills the ~6.5mo gap)."
}
